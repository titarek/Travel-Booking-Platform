{
  "name": "travel-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Travel - Full-Stack Travel Booking Platform inspired by ShareTrip",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:customer": "npm --prefix frontend-customer run dev",
    "dev:admin": "npm --prefix frontend-admin run dev",
    "build:backend": "npm --prefix backend install",
    "build:customer": "npm --prefix frontend-customer run build",
    "build:admin": "npm --prefix frontend-admin run build",
    "lint:backend": "npm --prefix backend run lint",
    "lint:customer": "npm --prefix frontend-customer run lint",
    "lint:admin": "npm --prefix frontend-admin run lint",
    "lint": "npm --prefix backend run lint && npm --prefix frontend-customer run lint && npm --prefix frontend-admin run lint"
  }
}
